# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi Postgres untuk aplikasi (pakai connection string "pooled" di Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Koneksi langsung (non-pooled) untuk drizzle-kit: migrate/push/studio.
# Boleh dikosongkan; drizzle-kit akan memakai DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# API key Google AI Studio untuk pencarian AI. Opsional: tanpa key,
# pencarian otomatis memakai kata kunci.
GEMINI_API_KEY=""

# Mode data contoh (default aktif). Isi "false" setelah data kos asli masuk:
# banner "data contoh" hilang, tombol WhatsApp aktif, halaman kos diindeks.
NEXT_PUBLIC_SAMPLE_DATA="true"

# URL publik situs untuk metadata/SEO. Di Vercel boleh dikosongkan
# (otomatis memakai domain production).
NEXT_PUBLIC_SITE_URL=""
